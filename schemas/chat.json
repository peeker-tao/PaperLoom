{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peeker-tao/PaperLoom/schemas/chat.json",
  "title": "Chat request and stream events",
  "definitions": {
    "Selection": {
      "type": "object",
      "required": ["text", "page"],
      "properties": {
        "text": { "type": "string", "maxLength": 20000 },
        "page": { "type": "integer", "minimum": 1 },
        "pageLabel": { "type": "string" },
        "rects": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "kind": { "type": "string", "enum": ["text", "formula", "figure"] }
      }
    },
    "ChatRequest": {
      "type": "object",
      "required": ["documentId", "messages"],
      "properties": {
        "documentId": { "type": "string" },
        "conversationId": { "type": "string" },
        "scope": { "type": "string", "enum": ["selection", "section", "paper"] },
        "selection": { "$ref": "#/definitions/Selection" },
        "image": {
          "type": "string",
          "description": "data:image/* base64 Data URL (max 8MB) for figure/formula questions"
        },
        "model": { "type": "string" },
        "maxOutputTokens": { "type": "integer", "minimum": 64, "maximum": 384000 },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string", "enum": ["system", "user", "assistant"] },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "ChatEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["citations", "delta", "usage", "done", "error"] },
        "text": { "type": "string" },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segmentId", "page"],
            "properties": {
              "segmentId": { "type": "string" },
              "page": { "type": "integer" },
              "quote": { "type": "string" }
            }
          }
        },
        "usage": { "type": "object" },
        "error": { "type": "object" }
      }
    }
  },
  "type": "object",
  "properties": {
    "request": { "$ref": "#/definitions/ChatRequest" },
    "event": { "$ref": "#/definitions/ChatEvent" }
  }
}
